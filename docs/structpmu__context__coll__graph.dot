digraph "pmu_context"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node1 [id="Node000001",label="pmu_context",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="PMU estimator context structure."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" synch_params",fontcolor="grey" ];
  Node2 [id="Node000002",label="SynchrophasorEstimatorParams",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_synchrophasor_estimator_params.html",tooltip="Internal parameters for synchrophasor estimation."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" phasor",fontcolor="grey" ];
  Node3 [id="Node000003",label="phasor",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structphasor.html",tooltip="Represents a synchrophasor (complex voltage/current measurement)"];
  Node4 -> Node1 [id="edge3_Node000001_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" buff_params",fontcolor="grey" ];
  Node4 [id="Node000004",label="InternalBuffers",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_internal_buffers.html",tooltip="Dynamically allocated internal buffers."];
  Node5 -> Node1 [id="edge4_Node000001_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" hann_params",fontcolor="grey" ];
  Node5 [id="Node000005",label="HanningTransformConstants",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_hanning_transform_constants.html",tooltip="Precomputed constants for Hanning window Fourier Transform."];
  Node6 -> Node1 [id="edge5_Node000001_Node000006",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" rocof_params",fontcolor="grey" ];
  Node6 [id="Node000006",label="RocoFEstimationStates",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_roco_f_estimation_states.html",tooltip="State variables for ROCOF (Rate of Change of Frequency) estimation."];
}
